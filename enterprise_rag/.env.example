# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ============================
# LLM API 配置
# ============================

# DeepSeek API（推荐）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 或使用通义千问
# QWEN_API_KEY=your_qwen_api_key_here

# 或使用智谱 GLM
# ZHIPU_API_KEY=your_zhipu_api_key_here

# ============================
# Milvus 配置（可选）
# ============================

# Milvus URI（本地文件或远程地址）
MILVUS_URI=./data/milvus_data.db

# Milvus Token（远程连接需要）
# MILVUS_TOKEN=root:Milvus

# ============================
# 其他配置
# ============================

# Embedding 模型选择
# EMBEDDING_MODEL=m3e_large

# 日志级别
# LOG_LEVEL=INFO

# API 服务器配置
# API_HOST=0.0.0.0
# API_PORT=8000
